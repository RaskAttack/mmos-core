{
  "manifest_version": 3,
  "name": "MMOS Context Tracker",
  "version": "2.0",
  "description": "Tracks active website for multiplayer cursors.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "https://mmos.retrotechspecs.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mmos-tracker@retrotechspecs.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
